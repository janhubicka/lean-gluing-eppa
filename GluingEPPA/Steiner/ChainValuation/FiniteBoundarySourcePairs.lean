import GluingEPPA.Steiner.ChainValuation.FiniteWitnessedHistoricalBoundaries

/-!
# Exact source-mask order of finite witnessed Link boundaries

An arbitrary list of boundary records would not suffice for
normalizing a consecutive historical support interval: the records
must occur in the exact order of the source atoms, and the record
at each interior position must correspond to the actual pair of
neighbouring historical Cayley masks.

The witnessed-boundary builder uses the literal LinkChain.step
recursion, and at each step transports every earlier boundary
without changing its two source masks while appending precisely
(currentMask, nextMask). Hence the ordered list of boundary source
pairs is exactly the consecutive-pair list of the input atoms.

This is a bookkeeping theorem with substantive consequences:
every adjacent pair of active historical blocks has a recorded
boundary whose parameter carrier is the *true earlier*
K_(A_i∩A_(i+1)), not an arbitrary representative group.

The final normalized smaller-mask component chart remains open.
-/

namespace GluingEPPA.Steiner
namespace EdgeGraph
namespace RecursiveRecord
namespace LinkChain

attribute [local instance] Classical.propDecidable

universe u
variable {V E : Type u}
variable (D : EdgeGraph V E) [Finite V] [Fintype E] [DecidableEq E]
variable (S : Finset E) (old : ∀ i : Proper S, Data E i.val)
variable (L : ∀ m t : Proper S, m.val ⊆ t.val → Link D (old m) (old t))

/-- Consecutive source-mask pairs generated by a list tail,
starting from the current historical block. -/
def tailSourceMaskPairs (c : Atom S old) :
    List (Atom S old) → List (Proper S × Proper S)
  | [] => []
  | z :: zs => (c.1, z.1) :: tailSourceMaskPairs z zs

/-- Exactly one pair for each adjacent pair of source atoms. -/
def consecutiveSourceMaskPairs :
    List (Atom S old) → List (Proper S × Proper S)
  | [] => []
  | x :: xs => tailSourceMaskPairs S old x xs

/-- Every further real LinkChain step appends exactly its new
consecutive mask pair to the historical boundary sequence. -/
theorem boundaryHistoryBuildTail_sourcePairs
    (M : Proper S) (p c : Atom S old)
    (H : BoundaryHistoryBuildResult D S old L M)
    (hprev : H.chain.previous = some p)
    (hcurr : H.chain.current = c)
    (rest : List (Atom S old))
    (hsep : separatedList D S old L (p :: c :: rest)) :
    (boundaryHistoryBuildTail D S old L M p c H hprev hcurr
      rest hsep).boundaries.map
      (fun T => (T.leftMask, T.rightMask)) =
    H.boundaries.map (fun T => (T.leftMask, T.rightMask)) ++
      tailSourceMaskPairs S old c rest := by
  induction rest generalizing p c H with
  | nil =>
      simp [boundaryHistoryBuildTail, tailSourceMaskPairs]
  | cons z zs ih =>
      have hstep :
          (match H.chain.previous with
          | none => True
          | some previous =>
              tripleSeparated D S old L previous H.chain.current z) := by
        rw [hprev, hcurr]
        exact hsep.1
      let HN := boundaryHistoryStep D S old L M H z hstep
      have hnprev : HN.chain.previous = some c := by
        change some H.chain.current = some c
        rw [hcurr]
      have hncurr : HN.chain.current = z := rfl
      have hIH := ih c z HN hnprev hncurr hsep.2
      have hStep :
          HN.boundaries.map (fun T => (T.leftMask, T.rightMask)) =
          H.boundaries.map (fun T => (T.leftMask, T.rightMask)) ++
            [(c.1, z.1)] := by
        have h := historicalBoundaries_step_masks
          D S old L M H.chain z hstep H.lastInv H.boundaries
        change
          HN.boundaries.map (fun T => (T.leftMask, T.rightMask)) =
          H.boundaries.map (fun T => (T.leftMask, T.rightMask)) ++
            [(H.chain.current.1, z.1)] at h
        rw [hcurr] at h
        exact h
      change
        (boundaryHistoryBuildTail D S old L M c z HN
          hnprev hncurr zs hsep.2).boundaries.map
            (fun T => (T.leftMask, T.rightMask)) =
        H.boundaries.map (fun T => (T.leftMask, T.rightMask)) ++
          tailSourceMaskPairs S old c (z :: zs)
      rw [hIH, hStep]
      simp only [tailSourceMaskPairs, List.append_cons, List.append_assoc]

/-- The entire finite boundary witness history has **exactly** one
record for each consecutive pair of the original input masks,
in precisely the same order. No arbitrary reindexing of the
historical blocks is used. -/
theorem boundaryHistoryBuildNonempty_sourcePairs
    (M : Proper S) (atoms : List (Atom S old))
    (hne : atoms ≠ [])
    (hsep : separatedList D S old L atoms) :
    (boundaryHistoryBuildNonempty D S old L M
      atoms hne hsep).boundaries.map
      (fun T => (T.leftMask, T.rightMask)) =
    consecutiveSourceMaskPairs S old atoms := by
  cases atoms with
  | nil =>
      exact False.elim (hne rfl)
  | cons x xs =>
      cases xs with
      | nil =>
          rfl
      | cons y ys =>
          let H0 := boundaryHistoryInitial D S old L M x
          let H1 := boundaryHistoryStep D S old L M H0 y trivial
          have hp : H1.chain.previous = some x := rfl
          have hc : H1.chain.current = y := rfl
          have hFirst :
              H1.boundaries.map (fun T => (T.leftMask, T.rightMask)) =
                [(x.1, y.1)] := by
            change
              (historicalBoundaries_step
                D S old L M (initial D S old L x) y trivial
                (initial_lastMaskCoset D S old L M x) []).map
                (fun T => (T.leftMask, T.rightMask)) =
              [(x.1, y.1)]
            simpa [historicalBoundaries_step,
              historicalLinkBoundary_step] using
              (historicalBoundaries_step_masks
                D S old L M (initial D S old L x) y trivial
                (initial_lastMaskCoset D S old L M x) [])
          change
            (boundaryHistoryBuildTail D S old L M
              x y H1 hp hc ys hsep).boundaries.map
                (fun T => (T.leftMask, T.rightMask)) =
            consecutiveSourceMaskPairs S old (x :: y :: ys)
          rw [boundaryHistoryBuildTail_sourcePairs
            D S old L M x y H1 hp hc ys hsep, hFirst]
          simp only [consecutiveSourceMaskPairs,
            tailSourceMaskPairs, List.append_cons,
            List.nil_append]

end LinkChain
end RecursiveRecord
end EdgeGraph
end GluingEPPA.Steiner
