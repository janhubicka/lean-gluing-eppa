import GluingEPPA.Steiner.ChainValuation.ActualChainTraversal
import Mathlib.Logic.Equiv.Fin.Rotate

/-!
# A bounded coset cycle gives an actual contradictory chain test

The cycle is stated using the subgroups generated by its masks. Its masks
are proved proper, its differences are lifted to the actual earlier groups,
and its separation gives both the literal chain predicate and the initial
point outside the first exit. The displacement product telescopes in the
ambient group. The final contradiction uses the actual recorded chain test.
-/

namespace GluingEPPA.Steiner.ChainValuation

universe u
variable {E G : Type u} [DecidableEq E] [Group G]

/-- The subgroup generated by exactly the named letters of a mask. -/
def maskSubgroup (edge : E → G) (A : Finset E) : Subgroup G :=
  Subgroup.closure (edge '' (A : Set E))

/-- The manuscript's cyclic connectivity and separation conditions. -/
structure CosetCycle (edge : E → G) (S : Finset E) (m : Nat) where
  two_le : 2 ≤ m
  point : Fin m → G
  mask : Fin m → Finset E
  mask_subset : ∀ i, mask i ⊆ S
  connected : ∀ i,
    point (finRotate m i) ∈ leftCoset (maskSubgroup edge (mask i)) (point i)
  separated : ∀ i,
    Disjoint
      (leftCoset (maskSubgroup edge (mask ((finRotate m).symm i) ∩ mask i)) (point i))
      (leftCoset (maskSubgroup edge (mask i ∩ mask (finRotate m i)))
        (point (finRotate m i)))

theorem CosetCycle.not_le_previous {edge : E → G} {S : Finset E} {m : Nat}
    (c : CosetCycle edge S m) (i : Fin m) :
    ¬ c.mask i ⊆ c.mask ((finRotate m).symm i) := by
  intro h
  have heq : c.mask ((finRotate m).symm i) ∩ c.mask i = c.mask i :=
    Finset.inter_eq_right.mpr h
  have hfirst : c.point (finRotate m i) ∈
      leftCoset (maskSubgroup edge (c.mask ((finRotate m).symm i) ∩ c.mask i))
        (c.point i) := by
    rw [heq]
    exact c.connected i
  exact Set.disjoint_left.1 (c.separated i) hfirst (self_mem_leftCoset _ _)

/-- Properness is a consequence of cycle separation, not an extra input. -/
theorem CosetCycle.mask_proper {edge : E → G} {S : Finset E} {m : Nat}
    (c : CosetCycle edge S m) (i : Fin m) : c.mask i ⊂ S := by
  refine lt_of_le_of_ne (c.mask_subset i) ?_
  intro heq
  apply c.not_le_previous (finRotate m i)
  intro e he
  have hi : e ∈ c.mask i := by
    simpa only [heq] using c.mask_subset (finRotate m i) he
  simpa only [Equiv.symm_apply_apply] using hi

theorem cycleNext_of_lt {m k : Nat} (h : k + 1 < m) :
    finRotate m ⟨k, by omega⟩ = ⟨k + 1, h⟩ := by
  cases m with
  | zero => omega
  | succ n => exact finRotate_of_lt (by omega)

theorem prod_linear_differences (n : Nat) (g : Fin (n + 1) → G) :
    (List.ofFn (fun i : Fin n => (g i.castSucc)⁻¹ * g i.succ)).prod =
      (g 0)⁻¹ * g (Fin.last n) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [List.ofFn_succ, List.prod_cons]
      have ht := ih (fun i : Fin (n + 1) => g i.succ)
      change (g 0)⁻¹ * g (Fin.succ 0) *
        (List.ofFn (fun i : Fin n => (g i.castSucc.succ)⁻¹ * g i.succ.succ)).prod = _
      rw [ht]
      change (g 0)⁻¹ * g (Fin.succ 0) *
        ((g (Fin.succ 0))⁻¹ * g (Fin.last (n + 1))) = _
      group

/-- The ordered cyclic product telescopes without commutativity. -/
theorem prod_cyclic_differences (m : Nat) (g : Fin m → G) :
    (List.ofFn (fun i : Fin m => (g i)⁻¹ * g (finRotate m i))).prod = 1 := by
  cases m with
  | zero => simp
  | succ n =>
      have hrot (i : Fin n) : finRotate (n + 1) i.castSucc = i.succ :=
        finRotate_of_lt i.isLt
      rw [List.ofFn_succ', List.concat_eq_append, List.prod_append, List.prod_singleton]
      simp only [hrot, finRotate_last]
      rw [prod_linear_differences]
      group

end GluingEPPA.Steiner.ChainValuation

namespace GluingEPPA.Steiner
namespace EdgeGraph
namespace RecursiveRecord
namespace LinkChain

attribute [local instance] Classical.propDecidable

universe u
variable {V E G : Type u}
variable (D : EdgeGraph V E) [Finite V] [Fintype E] [DecidableEq E]
variable (S : Finset E) (old : ∀ i : Proper S, Data E i.val)
variable (L : ∀ m t : Proper S, m.val ⊆ t.val → Link D (old m) (old t))
variable [Group G] (edge : E → G)
variable (incl : ∀ A : Proper S, (old A).Carrier →* G)
variable (hincl : ∀ A e, e ∈ A.val → incl A ((old A).edge e) = edge e)

open GluingEPPA.Steiner.ChainValuation

include hincl

omit [Fintype E] [DecidableEq E] in
/-- Each earlier inclusion has exactly the subgroup generated by its mask
as image. This does not require an independent subgroup-image assumption. -/
theorem stage_inclusion_range (A : Proper S) :
    (incl A).range = maskSubgroup edge A.val := by
  apply le_antisymm
  · rintro g ⟨x, rfl⟩
    obtain ⟨w, hw, rfl⟩ := (old A).generated x
    induction w with
    | nil => simpa only [List.map_nil, List.prod_nil, map_one] using
        (maskSubgroup edge A.val).one_mem
    | cons e w ih =>
        have he := hw e List.mem_cons_self
        have htail : ∀ f ∈ w, f ∈ A.val :=
          fun f hf => hw f (List.mem_cons_of_mem e hf)
        simp only [List.map_cons, List.prod_cons, map_mul]
        rw [hincl A e he]
        exact (maskSubgroup edge A.val).mul_mem
          (Subgroup.subset_closure ⟨e, he, rfl⟩) (ih htail)
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨e, he, rfl⟩
    exact ⟨(old A).edge e, hincl A e he⟩

omit [Finite V] [Fintype E] [DecidableEq E] in
/-- All old-to-current inclusion squares commute because the old group is
generated by its named letters. -/
theorem stage_inclusion_comp (A B : Proper S) (hAB : A.val ⊆ B.val) :
    (incl B).comp (L A B hAB).incl = incl A := by
  apply (old A).hom_ext
  intro e he
  change incl B ((L A B hAB).incl ((old A).edge e)) = incl A ((old A).edge e)
  rw [(L A B hAB).incl_edge e he, hincl B e (hAB he), hincl A e he]

omit [Finite V] [Fintype E] in
theorem stage_inclusion_left_mem (A B : Proper S)
    (x : (old (common S A B)).Carrier) :
    incl A (left D S old L A B x) ∈ maskSubgroup edge (A.val ∩ B.val) := by
  have h := DFunLike.congr_fun
    (stage_inclusion_comp D S old L edge incl hincl (common S A B) A
      Finset.inter_subset_left) x
  change incl A (left D S old L A B x) = incl (common S A B) x at h
  rw [h]
  change incl (common S A B) x ∈ maskSubgroup edge (common S A B).val
  rw [← stage_inclusion_range S old edge incl hincl (common S A B)]
  exact ⟨x, rfl⟩

omit [Finite V] [Fintype E] in
theorem stage_inclusion_right_mem (A B : Proper S)
    (x : (old (common S A B)).Carrier) :
    incl B (right D S old L A B x) ∈ maskSubgroup edge (A.val ∩ B.val) := by
  have h := DFunLike.congr_fun
    (stage_inclusion_comp D S old L edge incl hincl (common S A B) B
      Finset.inter_subset_right) x
  change incl B (right D S old L A B x) = incl (common S A B) x at h
  rw [h]
  change incl (common S A B) x ∈ maskSubgroup edge (common S A B).val
  rw [← stage_inclusion_range S old edge incl hincl (common S A B)]
  exact ⟨x, rfl⟩

omit [Finite V] [Fintype E] in
/-- Ambient coset separation implies the literal old-group attachment
separation used by the chain builder. -/
theorem tripleSeparated_of_coset_separated (x y z : Atom S old) (g h : G)
    (hshift : incl y.1 y.2 = g⁻¹ * h)
    (hsep : Disjoint
      (leftCoset (maskSubgroup edge (x.1.val ∩ y.1.val)) g)
      (leftCoset (maskSubgroup edge (y.1.val ∩ z.1.val)) h)) :
    tripleSeparated D S old L x y z := by
  apply Set.disjoint_left.mpr
  intro t ht hu
  change (1 : (old y.1).Carrier)⁻¹ * t ∈ (right D S old L x.1 y.1).range at ht
  simp only [inv_one, one_mul] at ht
  obtain ⟨a, ha⟩ := ht
  change y.2⁻¹ * t ∈ (left D S old L y.1 z.1).range at hu
  obtain ⟨b, hb⟩ := hu
  have ht' : t = y.2 * left D S old L y.1 z.1 b := by
    rw [hb]
    group
  have hfirst : g * incl y.1 t ∈
      leftCoset (maskSubgroup edge (x.1.val ∩ y.1.val)) g := by
    change g⁻¹ * (g * incl y.1 t) ∈ maskSubgroup edge (x.1.val ∩ y.1.val)
    rw [inv_mul_cancel_left, ← ha]
    exact stage_inclusion_right_mem D S old L edge incl hincl x.1 y.1 a
  have hsecond : g * incl y.1 t ∈
      leftCoset (maskSubgroup edge (y.1.val ∩ z.1.val)) h := by
    change h⁻¹ * (g * incl y.1 t) ∈ maskSubgroup edge (y.1.val ∩ z.1.val)
    rw [ht', map_mul, hshift]
    convert stage_inclusion_left_mem D S old L edge incl hincl y.1 z.1 b using 1
    group
  exact Set.disjoint_left.1 hsep hfirst hsecond

omit [Finite V] [Fintype E] in
/-- Separation at the cyclic first block puts its identity outside its
outgoing attachment. The incoming subgroup may be any subgroup. -/
theorem one_not_exit_of_coset_separated (x y : Atom S old) (H : Subgroup G)
    (g h : G) (hshift : incl x.1 x.2 = g⁻¹ * h)
    (hsep : Disjoint (leftCoset H g)
      (leftCoset (maskSubgroup edge (x.1.val ∩ y.1.val)) h)) :
    (1 : (old x.1).Carrier) ∉
      exitSet (block S old x.1) x.2 (left D S old L x.1 y.1) := by
  rintro ⟨a, ha⟩
  have hv := congrArg (incl x.1) ha
  change incl x.1 (x.2 * left D S old L x.1 y.1 a) = incl x.1 1 at hv
  rw [map_mul, map_one, hshift] at hv
  have hpoint : h⁻¹ * g = incl x.1 (left D S old L x.1 y.1 a) := by
    have heq := congrArg (fun z : G => h⁻¹ * g * z) hv
    simpa only [mul_assoc, mul_inv_cancel_left, inv_mul_cancel_left, mul_one] using heq.symm
  apply Set.disjoint_left.1 hsep (self_mem_leftCoset H g)
  change h⁻¹ * g ∈ maskSubgroup edge (x.1.val ∩ y.1.val)
  rw [hpoint]
  exact stage_inclusion_left_mem D S old L edge incl hincl x.1 y.1 a

omit hincl

omit [Finite V] [Fintype E] in
/-- Consecutive triples suffice for the literal finite list predicate. -/
theorem separatedList_ofFn_of_triples {n : Nat} (a : Fin n → Atom S old)
    (h : ∀ (i : Nat) (hi : i + 2 < n),
      tripleSeparated D S old L
        (a ⟨i, by omega⟩) (a ⟨i + 1, by omega⟩) (a ⟨i + 2, hi⟩)) :
    separatedList D S old L (List.ofFn a) := by
  induction n with
  | zero => trivial
  | succ n ih =>
      cases n with
      | zero => simp only [List.ofFn_succ, List.ofFn_zero, separatedList]
      | succ n =>
          cases n with
          | zero => simp only [List.ofFn_succ, List.ofFn_zero, separatedList]
          | succ n =>
              rw [List.ofFn_succ, List.ofFn_succ, List.ofFn_succ]
              constructor
              · exact h 0 (by omega)
              · have ht := ih (fun i => a i.succ) (by
                  intro i hi
                  exact h (i + 1) (by omega))
                simpa only [List.ofFn_succ] using ht

def cosetCycleMask {m : Nat} (c : CosetCycle edge S m) (i : Fin m) : Proper S :=
  ⟨c.mask i, c.mask_proper i⟩

include hincl

omit [Fintype E] in
/-- Connectivity lifts the cyclic difference to the actual earlier group. -/
theorem cosetCycle_displacement_exists {m : Nat} (c : CosetCycle edge S m) (i : Fin m) :
    ∃ h : (old (cosetCycleMask S edge c i)).Carrier,
      incl (cosetCycleMask S edge c i) h = (c.point i)⁻¹ * c.point (finRotate m i) := by
  have hm := c.connected i
  change (c.point i)⁻¹ * c.point (finRotate m i) ∈ maskSubgroup edge (c.mask i) at hm
  have hr := stage_inclusion_range S old edge incl hincl (cosetCycleMask S edge c i)
  change (incl (cosetCycleMask S edge c i)).range = maskSubgroup edge (c.mask i) at hr
  rw [← hr] at hm
  exact hm

noncomputable def cosetCycleDisplacement {m : Nat} (c : CosetCycle edge S m) (i : Fin m) :
    (old (cosetCycleMask S edge c i)).Carrier :=
  Classical.choose (cosetCycle_displacement_exists S old edge incl hincl c i)

omit [Fintype E] in
theorem cosetCycleDisplacement_spec {m : Nat} (c : CosetCycle edge S m) (i : Fin m) :
    incl (cosetCycleMask S edge c i) (cosetCycleDisplacement S old edge incl hincl c i) =
      (c.point i)⁻¹ * c.point (finRotate m i) :=
  Classical.choose_spec (cosetCycle_displacement_exists S old edge incl hincl c i)

/-- The last displacement is retained, even though it is unused by the
chain quotient: the traversal word reads this final displacement too. -/
noncomputable def cosetCycleAtom {m : Nat} (c : CosetCycle edge S m) (i : Fin m) :
    Atom S old :=
  ⟨cosetCycleMask S edge c i, cosetCycleDisplacement S old edge incl hincl c i⟩

omit [Fintype E] in
theorem cosetCycleAtom_incl {m : Nat} (c : CosetCycle edge S m) (i : Fin m) :
    incl (cosetCycleAtom S old edge incl hincl c i).1
        (cosetCycleAtom S old edge incl hincl c i).2 =
      (c.point i)⁻¹ * c.point (finRotate m i) :=
  cosetCycleDisplacement_spec S old edge incl hincl c i

omit [Finite V] [Fintype E] in
theorem cosetCycleAtom_triple {m : Nat} (c : CosetCycle edge S m)
    (i : Nat) (hi : i + 2 < m) :
    tripleSeparated D S old L
      (cosetCycleAtom S old edge incl hincl c ⟨i, by omega⟩)
      (cosetCycleAtom S old edge incl hincl c ⟨i + 1, by omega⟩)
      (cosetCycleAtom S old edge incl hincl c ⟨i + 2, hi⟩) := by
  have hprev : (finRotate m).symm ⟨i + 1, by omega⟩ = ⟨i, by omega⟩ := by
    rw [← cycleNext_of_lt (m := m) (k := i) (by omega)]
    exact Equiv.symm_apply_apply _ _
  have hnext : finRotate m ⟨i + 1, by omega⟩ = ⟨i + 2, hi⟩ :=
    cycleNext_of_lt (m := m) (k := i + 1) hi
  apply tripleSeparated_of_coset_separated D S old L edge incl hincl
    _ _ _ (c.point ⟨i + 1, by omega⟩) (c.point ⟨i + 2, hi⟩)
  · simpa only [hnext] using
      cosetCycleAtom_incl S old edge incl hincl c ⟨i + 1, by omega⟩
  · have hs := c.separated ⟨i + 1, by omega⟩
    rw [hprev, hnext] at hs
    exact hs

omit [Finite V] [Fintype E] in
theorem cosetCycle_atoms_separated {m : Nat} (c : CosetCycle edge S m) :
    separatedList D S old L (List.ofFn (cosetCycleAtom S old edge incl hincl c)) :=
  separatedList_ofFn_of_triples D S old L _
    (cosetCycleAtom_triple D S old L edge incl hincl c)

omit [Finite V] [Fintype E] in
/-- The first point's exit condition follows from the cyclic separation
at zero, including the last-to-first incoming alphabet. -/
theorem cosetCycle_start_outside_exit {m : Nat} (c : CosetCycle edge S m) :
    StartOutsideExit D S old L (List.ofFn (cosetCycleAtom S old edge incl hincl c)) := by
  have htwo := c.two_le
  cases m with
  | zero => omega
  | succ n =>
      cases n with
      | zero => omega
      | succ n =>
          rw [List.ofFn_succ, List.ofFn_succ]
          change (1 : (old (cosetCycleMask S edge c 0)).Carrier) ∉
            exitSet (block S old (cosetCycleAtom S old edge incl hincl c 0).1)
              (cosetCycleAtom S old edge incl hincl c 0).2
              (left D S old L (cosetCycleAtom S old edge incl hincl c 0).1
                (cosetCycleAtom S old edge incl hincl c (Fin.succ 0)).1)
          apply one_not_exit_of_coset_separated D S old L edge incl hincl
            (cosetCycleAtom S old edge incl hincl c 0)
            (cosetCycleAtom S old edge incl hincl c (Fin.succ 0))
            (maskSubgroup edge (c.mask ((finRotate (n + 2)).symm 0) ∩ c.mask 0))
            (c.point 0) (c.point (finRotate (n + 2) 0))
          · exact cosetCycleAtom_incl S old edge incl hincl c 0
          · have hnext : finRotate (n + 2) 0 = Fin.succ 0 :=
              cycleNext_of_lt (m := n + 2) (k := 0) (by omega)
            simpa only [hnext, cosetCycleAtom, cosetCycleMask] using c.separated 0

/-- The unrolled cycle is an actual member of the recorded finite test
package, with its original cyclic length. -/
noncomputable def cosetCycleSeparatedTest (N : Nat) {m : Nat}
    (c : CosetCycle edge S m) (hbound : m ≤ N) :
    SeparatedChains D N S old L :=
  ⟨⟨⟨⟨m, Nat.lt_succ_of_le hbound⟩, Nat.lt_of_lt_of_le (by decide : 0 < 2) c.two_le⟩,
    cosetCycleAtom S old edge incl hincl c⟩,
    cosetCycle_atoms_separated D S old L edge incl hincl c⟩

omit [Finite V] [Fintype E] in
@[simp] theorem cosetCycleSeparatedTest_length (N : Nat) {m : Nat}
    (c : CosetCycle edge S m) (hbound : m ≤ N) :
    ((cosetCycleSeparatedTest D S old L edge incl hincl N c hbound).val.1.val : Nat) = m := rfl

omit [Finite V] [Fintype E] in
theorem cosetCycleSeparatedTest_start (N : Nat) {m : Nat}
    (c : CosetCycle edge S m) (hbound : m ≤ N) :
    StartOutsideExit D S old L
      (List.ofFn (cosetCycleSeparatedTest D S old L edge incl hincl N c hbound).val.2) :=
  cosetCycle_start_outside_exit D S old L edge incl hincl c

omit [Finite V] [Fintype E] in
/-- The actual test's ordered old-group displacements telescope in the
ambient group, including the final last-to-first displacement. -/
theorem cosetCycleSeparatedTest_product (N : Nat) {m : Nat}
    (c : CosetCycle edge S m) (hbound : m ≤ N) :
    ((List.ofFn (cosetCycleSeparatedTest D S old L edge incl hincl N c hbound).val.2).map
      (fun a => incl a.1 a.2)).prod = 1 := by
  change ((List.ofFn (cosetCycleAtom S old edge incl hincl c)).map
    (fun a => incl a.1 a.2)).prod = 1
  rw [List.map_ofFn]
  change (List.ofFn (fun i : Fin m => incl (cosetCycleAtom S old edge incl hincl c i).1
    (cosetCycleAtom S old edge incl hincl c i).2)).prod = 1
  have hfun : (fun i : Fin m => incl (cosetCycleAtom S old edge incl hincl c i).1
      (cosetCycleAtom S old edge incl hincl c i).2) =
      (fun i : Fin m => (c.point i)⁻¹ * c.point (finRotate m i)) :=
    funext (cosetCycleAtom_incl S old edge incl hincl c)
  rw [hfun]
  exact prod_cyclic_differences m c.point

omit hincl

/-- The actual augmented stage has no bounded coset cycle once the
earlier groups include with their named generator values. Chain separation,
the moved endpoint, and the identity product are all derived above. -/
theorem augmented_no_bounded_coset_cycle (N : Nat)
    (currentIncl : ∀ A : Proper S, (old A).Carrier →*
      (AugmentedStep.data D S old (chainSpace D N S old L)
        (chainPerm D N S old L) (chainPerm_square D N S old L)).Carrier)
    (hcurrentIncl : ∀ A e, e ∈ A.val → currentIncl A ((old A).edge e) =
      (AugmentedStep.data D S old (chainSpace D N S old L)
        (chainPerm D N S old L) (chainPerm_square D N S old L)).edge e)
    {m : Nat}
    (c : CosetCycle
      (AugmentedStep.data D S old (chainSpace D N S old L)
        (chainPerm D N S old L) (chainPerm_square D N S old L)).edge S m)
    (hbound : m ≤ N) : False := by
  let test := cosetCycleSeparatedTest D S old L _ currentIncl hcurrentIncl N c hbound
  have hstart := cosetCycleSeparatedTest_start D S old L _ currentIncl hcurrentIncl N c hbound
  have hnontrivial := augmented_chain_displacement_product_ne_one D S old L N
    currentIncl hcurrentIncl test hstart
  exact hnontrivial
    (cosetCycleSeparatedTest_product D S old L _ currentIncl hcurrentIncl N c hbound)

/-- The existing current-stage Link interface supplies all premises of
the bounded coset-cycle contradiction. -/
theorem augmented_no_bounded_coset_cycle_of_links (N : Nat)
    (currentLinks : ∀ A : Proper S,
      Link D (old A)
        (AugmentedStep.data D S old (chainSpace D N S old L)
          (chainPerm D N S old L) (chainPerm_square D N S old L)))
    {m : Nat}
    (c : CosetCycle
      (AugmentedStep.data D S old (chainSpace D N S old L)
        (chainPerm D N S old L) (chainPerm_square D N S old L)).edge S m)
    (hbound : m ≤ N) : False :=
  augmented_no_bounded_coset_cycle D S old L N
    (fun A => (currentLinks A).incl) (fun A => (currentLinks A).incl_edge) c hbound

end LinkChain
