import Mathlib

/-!
# Components of a line of partial matchings

The restricted pieces of adjacent Cayley blocks are connected by partial
matchings. A path of such matchings cannot contain two different pieces
at the same level. We isolate this fact without subgroup or quotient notation.
The remaining geometric task is to identify the components of the actual
restricted chain with this combinatorial path relation.
-/

namespace GluingEPPA.Steiner.ChainValuation

universe u
variable {V : Nat → Type u}

/-- A matching between each pair of consecutive layers, encoded by a partial
forward map and its partial inverse. -/
structure LayerMatch (V : Nat → Type u) where
  forward : ∀ n, V n → Option (V (n + 1))
  backward : ∀ n, V (n + 1) → Option (V n)
  inverse_iff : ∀ n (x : V n) (y : V (n + 1)),
    forward n x = some y ↔ backward n y = some x

namespace LayerMatch
variable (P : LayerMatch V)

/-- The earliest point reached by moving backwards along matching edges. -/
def root : (n : Nat) → V n → Sigma V
  | 0, x => ⟨0, x⟩
  | n + 1, x =>
      match P.backward n x with
      | none => ⟨n + 1, x⟩
      | some y => P.root n y

/-- The root of a layer-n point lies at a layer of index at most n. -/
theorem root_le : ∀ (n : Nat) (x : V n), (P.root n x).1 ≤ n := by
  intro n
  induction n with
  | zero =>
      intro x
      simp [root]
  | succ n ih =>
      intro x
      cases h : P.backward n x with
      | none =>
          simp [root, h]
      | some y =>
          simp only [root, h]
          exact (ih y).trans (Nat.le_succ n)

/-- The partial backward map is injective on its defined fibre. -/
theorem backward_same {n : Nat} {x y : V (n + 1)} {z : V n}
    (hx : P.backward n x = some z)
    (hy : P.backward n y = some z) : x = y := by
  have hfx : P.forward n z = some x := (P.inverse_iff n z x).2 hx
  have hfy : P.forward n z = some y := (P.inverse_iff n z y).2 hy
  exact Option.some.inj (hfx.symm.trans hfy)

/-- No two distinct points of one layer have the same root. -/
theorem root_injective : ∀ (n : Nat) (x y : V n),
    P.root n x = P.root n y → x = y := by
  intro n
  induction n with
  | zero =>
      intro x y h
      simpa [root] using h
  | succ n ih =>
      intro x y h
      cases hx : P.backward n x with
      | none =>
          cases hy : P.backward n y with
          | none =>
              simpa [root, hx, hy] using h
          | some z =>
              have hroots : (⟨n + 1, x⟩ : Sigma V) = P.root n z := by
                simpa [root, hx, hy] using h
              have hn : n + 1 ≤ n := by
                have hindex := congrArg Sigma.fst hroots
                have hle := P.root_le n z
                omega
              omega
      | some z =>
          cases hy : P.backward n y with
          | none =>
              have hroots : P.root n z = (⟨n + 1, y⟩ : Sigma V) := by
                simpa [root, hx, hy] using h
              have hn : n + 1 ≤ n := by
                have hindex := congrArg Sigma.fst hroots
                have hle := P.root_le n z
                omega
              omega
          | some z' =>
              have hprev : P.root n z = P.root n z' := by
                simpa [root, hx, hy] using h
              have hzz : z = z' := ih z z' hprev
              subst z'
              exact P.backward_same hx hy

/-- Connectivity generated by matching links between consecutive layers. -/
inductive Connected : Sigma V → Sigma V → Prop
  | refl (x : Sigma V) : Connected x x
  | forward (n : Nat) (x : V n) (y : V (n + 1))
      (h : P.forward n x = some y) :
      Connected ⟨n, x⟩ ⟨n + 1, y⟩
  | symm {x y : Sigma V} : Connected x y → Connected y x
  | trans {x y z : Sigma V} : Connected x y → Connected y z → Connected x z

/-- The root is constant along a connected sequence of partial matchings. -/
theorem root_of_connected {x y : Sigma V}
    (h : P.Connected x y) :
    P.root x.1 x.2 = P.root y.1 y.2 := by
  induction h with
  | refl x => rfl
  | forward n x y hf =>
      have hb : P.backward n y = some x := (P.inverse_iff n x y).1 hf
      simp [root, hb]
  | symm h ih => exact ih.symm
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A connected component of a path of partial matchings contains at most
one point from each layer. This is the global no-merging conclusion used in
the geometric chain-restriction induction. -/
theorem connected_same_layer (n : Nat) (x y : V n)
    (h : P.Connected ⟨n, x⟩ ⟨n, y⟩) : x = y :=
  P.root_injective n x y (P.root_of_connected h)

/-- Every point is joined to its earliest predecessor by the matching edges.
This is the converse direction to constancy of the root along paths. -/
theorem connected_to_root : ∀ (n : Nat) (x : V n),
    P.Connected (P.root n x) ⟨n, x⟩ := by
  intro n
  induction n with
  | zero =>
      intro x
      change P.Connected ⟨0, x⟩ ⟨0, x⟩
      exact Connected.refl _
  | succ n ih =>
      intro x
      cases hb : P.backward n x with
      | none =>
          have hr : P.root (n + 1) x = ⟨n + 1, x⟩ := by
            simp [root, hb]
          rw [hr]
          exact Connected.refl _
      | some y =>
          have hr : P.root (n + 1) x = P.root n y := by
            simp [root, hb]
          rw [hr]
          exact Connected.trans (ih y)
            (Connected.forward n y x ((P.inverse_iff n y x).2 hb))

/-- The connected components of a line of partial matchings are classified
exactly by their earliest roots. They cannot branch, merge, or revisit a
layer. This theorem replaces repeated path-shortening arguments. -/
theorem connected_iff_same_root (x y : Sigma V) :
    P.Connected x y ↔ P.root x.1 x.2 = P.root y.1 y.2 := by
  constructor
  · exact P.root_of_connected
  · intro h
    have hx := P.connected_to_root x.1 x.2
    have hy : P.Connected (P.root x.1 x.2) y := by
      rw [h]
      exact P.connected_to_root y.1 y.2
    exact Connected.trans (Connected.symm hx) hy

end LayerMatch
end GluingEPPA.Steiner.ChainValuation
