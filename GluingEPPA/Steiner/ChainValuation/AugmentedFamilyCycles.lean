import GluingEPPA.Steiner.ChainValuation.AugmentedFamilyLinks
import GluingEPPA.Steiner.ChainValuation.AugmentedComponentReflection
import GluingEPPA.Steiner.ChainValuation.CosetCycleChainTest

/-!
# Component cycles and the actual augmented recursive family

The component-cycle definition uses walks in the literal Cayley lift.
Reflection is derived from the component coordinate of the same actual
recursive record and its proved Links. A separated component cycle then
gives the precise coset cycle used by the bounded-chain contradiction.
-/

namespace GluingEPPA.Steiner
namespace ChainValuation

universe u
variable {V E G : Type u} [DecidableEq E] [Group G]

/-- A separated cycle of actual lifted components, as in manuscript Part II. -/
structure ComponentCycle (D : EdgeGraph V E) (edge : E → G)
    (S : Finset E) (m : Nat) where
  two_le : 2 ≤ m
  vertex : Fin m → V × G
  mask : Fin m → Finset E
  mask_subset : ∀ i, mask i ⊆ S
  connected : ∀ i, D.CayleyWalk (mask i : Set E) edge
    (vertex i).1 (vertex i).2 (vertex (finRotate m i)).1 (vertex (finRotate m i)).2
  separated : ∀ i,
    Disjoint
      (D.componentSet ((mask ((finRotate m).symm i) ∩ mask i : Finset E) : Set E)
        edge (vertex i))
      (D.componentSet ((mask i ∩ mask (finRotate m i) : Finset E) : Set E)
        edge (vertex (finRotate m i)))

/-- Actual lift connectivity gives coset connectivity. Reflection transfers
the separation condition in the direction needed for the contradiction. -/
def ComponentCycle.toCosetCycle {D : EdgeGraph V E} {edge : E → G}
    {S : Finset E} {m : Nat} (c : ComponentCycle D edge S m)
    (hreflection : ∀ (A B : Finset E) (s t : V) (g h : G),
      D.CayleyWalk Set.univ edge s g t h →
      ((leftCoset (maskSubgroup edge A) g ∩ leftCoset (maskSubgroup edge B) h).Nonempty ↔
        (D.componentSet (A : Set E) edge (s, g) ∩
          D.componentSet (B : Set E) edge (t, h)).Nonempty)) :
    CosetCycle edge S m where
  two_le := c.two_le
  point i := (c.vertex i).2
  mask := c.mask
  mask_subset := c.mask_subset
  connected i := by
    change (c.vertex i).2⁻¹ * (c.vertex (finRotate m i)).2 ∈
      maskSubgroup edge (c.mask i)
    exact D.chain_walkValue_mem edge (maskSubgroup edge (c.mask i))
      (fun e he => Subgroup.subset_closure ⟨e, he, rfl⟩) (c.connected i).value
  separated i := by
    apply Set.disjoint_left.2
    intro x hx hy
    have hc := (c.connected i).mono (Set.subset_univ _)
    have hr := hreflection
      (c.mask ((finRotate m).symm i) ∩ c.mask i)
      (c.mask i ∩ c.mask (finRotate m i))
      (c.vertex i).1 (c.vertex (finRotate m i)).1
      (c.vertex i).2 (c.vertex (finRotate m i)).2 hc
    obtain ⟨z, hz, hz'⟩ := hr.mp ⟨x, hx, hy⟩
    exact Set.disjoint_left.1 (c.separated i) hz hz'

end ChainValuation

namespace EdgeGraph
namespace RecursiveRecord

universe u
variable {V E : Type u} (D : EdgeGraph V E)

open GluingEPPA.Steiner.ChainValuation

namespace Link

/-- The range of any actual Link is precisely the subgroup generated by
its source alphabet, also when that alphabet is the whole target. -/
theorem range_eq_maskSubgroup {M S : Finset E}
    (A : Data E M) (B : Data E S) (L : Link D A B) :
    L.incl.range = maskSubgroup B.edge M := by
  apply le_antisymm
  · intro g hg
    obtain ⟨w, hw, rfl⟩ := range_word_generation D A B L g hg
    clear hg
    induction w with
    | nil => exact (maskSubgroup B.edge M).one_mem
    | cons e w ih =>
        exact (maskSubgroup B.edge M).mul_mem
          (Subgroup.subset_closure ⟨e, hw e List.mem_cons_self, rfl⟩)
          (ih (fun f hf => hw f (List.mem_cons_of_mem e hf)))
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨e, he, rfl⟩
    exact ⟨A.edge e, L.incl_edge e he⟩

end Link

/-- Every actual Data group is generated by its full allowed alphabet. -/
theorem Data.maskSubgroup_eq_top {S : Finset E} (A : Data E S) :
    maskSubgroup A.edge S = ⊤ := by
  apply le_antisymm le_top
  intro x hx
  clear hx
  obtain ⟨w, hw, rfl⟩ := A.generated x
  induction w with
  | nil => exact (maskSubgroup A.edge S).one_mem
  | cons e w ih =>
      exact (maskSubgroup A.edge S).mul_mem
        (Subgroup.subset_closure ⟨e, hw e List.mem_cons_self, rfl⟩)
        (ih (fun f hf => hw f (List.mem_cons_of_mem e hf)))

namespace AugmentedFamily

variable [Finite V] [Fintype E] [DecidableEq E]

/-- Equality in the actual full family group is recorded on every earlier
component coordinate; the recursion's stage equation discharges the premise. -/
theorem full_component_record (N : Nat) (M : Proper (Finset.univ : Finset E))
    (p q : List E)
    (hvalue : (p.map (family D N Finset.univ).edge).prod =
      (q.map (family D N Finset.univ).edge).prod) :
    D.componentWordPerm (M.val : Set E) (family D N M.val).edge
        (fun e _ => (family D N M.val).square e) p =
      D.componentWordPerm (M.val : Set E) (family D N M.val).edge
        (fun e _ => (family D N M.val).square e) q := by
  rw [family_record_eq D N Finset.univ] at hvalue
  exact AugmentedStep.full_component_record D
    (fun i => family D N i.val)
    (LinkChain.chainSpace D N Finset.univ (fun i => family D N i.val)
      (earlierLinks D N Finset.univ))
    (LinkChain.chainPerm D N Finset.univ (fun i => family D N i.val)
      (earlierLinks D N Finset.univ))
    (LinkChain.chainPerm_square D N Finset.univ (fun i => family D N i.val)
      (earlierLinks D N Finset.univ)) M p q hvalue

/-- Full reflection for the constructed family, including the whole-alphabet
cases. No action, compatibility, or endpoint-repair hypothesis remains. -/
theorem coset_component_reflection (N : Nat) (A B : Finset E)
    {s t : V} {g h : (family D N Finset.univ).Carrier}
    (hconnected : D.CayleyWalk Set.univ (family D N Finset.univ).edge s g t h) :
    (leftCoset (maskSubgroup (family D N Finset.univ).edge A) g ∩
      leftCoset (maskSubgroup (family D N Finset.univ).edge B) h).Nonempty ↔
      (D.componentSet (A : Set E) (family D N Finset.univ).edge (s, g) ∩
        D.componentSet (B : Set E) (family D N Finset.univ).edge (t, h)).Nonempty := by
  by_cases hB : B = Finset.univ
  · subst B
    rw [Data.maskSubgroup_eq_top (family D N Finset.univ)]
    constructor
    · intro _
      refine ⟨(s, g), ?_, ?_⟩
      · exact CayleyWalk.nil s g
      · change D.CayleyWalk ((Finset.univ : Finset E) : Set E)
          (family D N Finset.univ).edge t h s g
        simpa only [Finset.coe_univ] using
          hconnected.symm (fun e _ => (family D N Finset.univ).square e)
    · intro _
      exact ⟨g, self_mem_leftCoset _ _, show h⁻¹ * g ∈ (⊤ : Subgroup _) from trivial⟩
  · let bp : Proper (Finset.univ : Finset E) :=
      ⟨B, lt_of_le_of_ne (Finset.subset_univ _) hB⟩
    let LA := familyLink D N A Finset.univ (Finset.subset_univ _)
    let LB := familyLink D N B Finset.univ (Finset.subset_univ _)
    have hr := D.chain_coset_component_reflection
      (family D N Finset.univ).edge (B : Set E)
      (family D N B).edge (fun e _ => (family D N B).square e)
      LB.incl LB.incl_edge (family D N Finset.univ).square LA.incl.range
      (fun e he => ⟨(family D N A).edge e, LA.incl_edge e he⟩)
      (Link.range_word_generation D (family D N A) _ LA)
      (family D N B).generated
      (full_component_record D N bp)
      (fun v w k p hk => Link.repair_range D (family D N A) _ LA
        (by simpa only [Finset.coe_univ] using p) hk) hconnected
    simpa only [Link.range_eq_maskSubgroup D (family D N A) _ LA,
      Link.range_eq_maskSubgroup D (family D N B) _ LB] using hr

/-- The actual finite recursive family has no coset cycle of length at most
N. The cycle definition includes the lower bound two. All Link and action
premises of the literal chain contradiction are discharged. -/
theorem no_bounded_coset_cycle (N : Nat) (S : Finset E) {m : Nat}
    (c : CosetCycle (family D N S).edge S m) (hbound : m ≤ N) : False := by
  rw [family_record_eq D N S] at c
  exact LinkChain.augmented_no_bounded_coset_cycle_of_links D S
    (fun i => family D N i.val) (earlierLinks D N S) N
    (stageLink D N S (earlierLinks D N S)) c hbound

/-- The literal full lift of the actual augmented recursive family has no
separated component cycle of length two through N. -/
theorem no_bounded_component_cycle (N : Nat) {m : Nat}
    (c : ComponentCycle D (family D N Finset.univ).edge Finset.univ m)
    (hbound : m ≤ N) : False := by
  apply no_bounded_coset_cycle D N Finset.univ
    (c.toCosetCycle (fun A B _ _ _ _ hc => coset_component_reflection D N A B hc))
    hbound

end AugmentedFamily
end RecursiveRecord
end EdgeGraph
end GluingEPPA.Steiner
