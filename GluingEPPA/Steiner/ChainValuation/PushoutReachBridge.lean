import GluingEPPA.Steiner.ChainValuation.MatchingGluing
import GluingEPPA.Steiner.ChainValuation.Pushout

/-!
# Labelled reachability in an actual injective pushout

The abstract matching-gluing theorem identifies components of an explicitly
presented gluing relation. Here we verify the missing graph-theoretic bridge:
the relation generated by actual labelled edges on the quotient pushout is
*exactly* old labelled reachability, new labelled reachability and the
prescribed attachment. The statement uses the literal quotient `SetPushout`,
not an isomorphic replacement.

This module does not assert the global chain-restriction theorem.
-/

namespace GluingEPPA.Steiner.ChainValuation

universe u v w t
variable {E : Type u} {X : Type v} {Y : Type w} {Z : Type t}

/-- Undirected connectivity generated by the genuine edges of colours in M.
This also captures connectivity under completed matching involutions:
fixed points do not create new components. -/
inductive LabelReach (R : E → X → X → Prop) (M : Finset E) :
    X → X → Prop where
  | refl (x : X) : LabelReach R M x x
  | edge {x y : X} (e : E) (he : e ∈ M) (h : R e x y) :
      LabelReach R M x y
  | symm {x y : X} (h : LabelReach R M x y) :
      LabelReach R M y x
  | trans {x y z : X} (h : LabelReach R M x y)
      (k : LabelReach R M y z) : LabelReach R M x z

/-- The equivalence classes of M-coloured undirected paths. -/
def labelReachSetoid (R : E → X → X → Prop) (M : Finset E) : Setoid X where
  r := LabelReach R M
  iseqv := by
    refine ⟨?_, ?_, ?_⟩
    · intro x
      exact LabelReach.refl x
    · intro x y h
      exact LabelReach.symm h
    · intro x y z h k
      exact LabelReach.trans h k

/-- An edge-preserving map preserves all labelled paths. -/
theorem LabelReach.map (R : E → X → X → Prop) (S : E → Y → Y → Prop)
    (M : Finset E) (f : X → Y)
    (hmap : ∀ e x y, R e x y → S e (f x) (f y))
    {x y : X} (h : LabelReach R M x y) :
    LabelReach S M (f x) (f y) := by
  induction h with
  | refl x => exact LabelReach.refl _
  | edge e he hr => exact LabelReach.edge e he (hmap e _ _ hr)
  | symm h ih => exact LabelReach.symm ih
  | trans h k ih ik => exact LabelReach.trans ih ik

/-- Pointwise equivalence of genuine-edge relations induces the same
undirected M-components, with no assumption about unused colours. -/
theorem LabelReach.congr (R S : E → X → X → Prop) (M : Finset E)
    (hiff : ∀ e x y, R e x y ↔ S e x y) (x y : X) :
    LabelReach R M x y ↔ LabelReach S M x y := by
  constructor
  · intro h
    induction h with
    | refl x => exact LabelReach.refl _
    | edge e he hr => exact LabelReach.edge e he ((hiff e _ _).mp hr)
    | symm h ih => exact LabelReach.symm ih
    | trans h k ih ik => exact LabelReach.trans ih ik
  · intro h
    induction h with
    | refl x => exact LabelReach.refl _
    | edge e he hr => exact LabelReach.edge e he ((hiff e _ _).mpr hr)
    | symm h ih => exact LabelReach.symm ih
    | trans h k ih ik => exact LabelReach.trans ih ik

/-- The literal quotient map, with no choice of representative. -/
def pushoutPoint (f : Z → X) (g : Z → Y)
    (hf : Function.Injective f) (hg : Function.Injective g) :
    Sum X Y → SetPushout f g hf hg :=
  fun a => Quotient.mk (pushoutSetoid f g hf hg) a

theorem pushoutPoint_surjective (f : Z → X) (g : Z → Y)
    (hf : Function.Injective f) (hg : Function.Injective g) :
    Function.Surjective (pushoutPoint f g hf hg) := by
  intro q
  refine Quotient.inductionOn q ?_
  intro a
  exact ⟨a, rfl⟩

/-- Genuine quotient edges are exactly the union of images of genuine
edges in the old and the new pieces. -/
def pushoutLabelRel (R : E → X → X → Prop) (S : E → Y → Y → Prop)
    (f : Z → X) (g : Z → Y)
    (hf : Function.Injective f) (hg : Function.Injective g)
    (e : E) : SetPushout f g hf hg → SetPushout f g hf hg → Prop :=
  fun q r =>
    (∃ x y, R e x y ∧
      pushoutPoint f g hf hg (.inl x) = q ∧
      pushoutPoint f g hf hg (.inl y) = r) ∨
    (∃ x y, S e x y ∧
      pushoutPoint f g hf hg (.inr x) = q ∧
      pushoutPoint f g hf hg (.inr y) = r)

/-- Any quotient equality is generated by exactly one prescribed
attachment (or equality within a side). -/
theorem gluedReach_of_pushoutPoint_eq
    (R : E → X → X → Prop) (S : E → Y → Y → Prop)
    (M : Finset E) (f : Z → X) (g : Z → Y)
    (hf : Function.Injective f) (hg : Function.Injective g)
    (a b : Sum X Y)
    (h : pushoutPoint f g hf hg a = pushoutPoint f g hf hg b) :
    GluedReach (labelReachSetoid R M) (labelReachSetoid S M) f g a b := by
  have hr : pushoutRel f g a b := Quotient.exact h
  cases a with
  | inl x =>
      cases b with
      | inl y =>
          change x = y at hr
          subst y
          exact GluedReach.refl _
      | inr y =>
          change ∃ z, f z = x ∧ g z = y at hr
          rcases hr with ⟨z, rfl, rfl⟩
          exact GluedReach.attach z
  | inr y =>
      cases b with
      | inl x =>
          change ∃ z, g z = y ∧ f z = x at hr
          rcases hr with ⟨z, rfl, rfl⟩
          exact GluedReach.symm (GluedReach.attach z)
      | inr y' =>
          change y = y' at hr
          subst y'
          exact GluedReach.refl _

/-- Every abstract gluing path gives a genuine path of the same selected
colours in the quotient. -/
theorem gluedReach_to_pushoutReach
    (R : E → X → X → Prop) (S : E → Y → Y → Prop)
    (M : Finset E) (f : Z → X) (g : Z → Y)
    (hf : Function.Injective f) (hg : Function.Injective g)
    {a b : Sum X Y}
    (h : GluedReach (labelReachSetoid R M) (labelReachSetoid S M) f g a b) :
    LabelReach (pushoutLabelRel R S f g hf hg) M
      (pushoutPoint f g hf hg a) (pushoutPoint f g hf hg b) := by
  induction h with
  | refl a => exact LabelReach.refl _
  | old h =>
      exact LabelReach.map R (pushoutLabelRel R S f g hf hg) M
        (fun x => pushoutPoint f g hf hg (.inl x))
        (fun e x y hr => Or.inl ⟨x, y, hr, rfl, rfl⟩) h
  | new h =>
      exact LabelReach.map S (pushoutLabelRel R S f g hf hg) M
        (fun y => pushoutPoint f g hf hg (.inr y))
        (fun e x y hr => Or.inr ⟨x, y, hr, rfl, rfl⟩) h
  | attach z =>
      have heq : pushoutPoint f g hf hg (.inl (f z)) =
          pushoutPoint f g hf hg (.inr (g z)) := by
        exact Quotient.sound ⟨z, rfl, rfl⟩
      rw [heq]
      exact LabelReach.refl _
  | symm h ih => exact LabelReach.symm ih
  | trans h k ih ik => exact LabelReach.trans ih ik

/-- Conversely a real quotient path lifts, up to prescribed attachments,
to a gluing path between any chosen representatives of its endpoints. -/
theorem pushoutReach_to_gluedReach
    (R : E → X → X → Prop) (S : E → Y → Y → Prop)
    (M : Finset E) (f : Z → X) (g : Z → Y)
    (hf : Function.Injective f) (hg : Function.Injective g)
    {q r : SetPushout f g hf hg}
    (h : LabelReach (pushoutLabelRel R S f g hf hg) M q r)
    (a b : Sum X Y)
    (ha : pushoutPoint f g hf hg a = q)
    (hb : pushoutPoint f g hf hg b = r) :
    GluedReach (labelReachSetoid R M) (labelReachSetoid S M) f g a b := by
  induction h generalizing a b with
  | refl q =>
      exact gluedReach_of_pushoutPoint_eq R S M f g hf hg a b
        (ha.trans hb.symm)
  | edge e he hr =>
      rcases hr with ⟨x, y, hxy, hqx, hqy⟩ |
        ⟨x, y, hxy, hqx, hqy⟩
      · have hleft := gluedReach_of_pushoutPoint_eq R S M f g hf hg
          a (.inl x) (ha.trans hqx.symm)
        have hright := gluedReach_of_pushoutPoint_eq R S M f g hf hg
          (.inl y) b (hqy.trans hb.symm)
        exact GluedReach.trans hleft
          (GluedReach.trans
            (GluedReach.old (LabelReach.edge e he hxy)) hright)
      · have hleft := gluedReach_of_pushoutPoint_eq R S M f g hf hg
          a (.inr x) (ha.trans hqx.symm)
        have hright := gluedReach_of_pushoutPoint_eq R S M f g hf hg
          (.inr y) b (hqy.trans hb.symm)
        exact GluedReach.trans hleft
          (GluedReach.trans
            (GluedReach.new (LabelReach.edge e he hxy)) hright)
  | symm h ih =>
      exact GluedReach.symm (ih b a hb ha)
  | trans h k ih ik =>
      obtain ⟨c, hc⟩ := pushoutPoint_surjective f g hf hg _
      exact GluedReach.trans (ih a c ha hc) (ik c b hc hb)

/-- Fundamental one-attachment bridge for *actual quotient vertices*.
There is no extra identification hidden in the gluing. -/
theorem pushoutReach_iff_gluedReach
    (R : E → X → X → Prop) (S : E → Y → Y → Prop)
    (M : Finset E) (f : Z → X) (g : Z → Y)
    (hf : Function.Injective f) (hg : Function.Injective g)
    (a b : Sum X Y) :
    LabelReach (pushoutLabelRel R S f g hf hg) M
      (pushoutPoint f g hf hg a) (pushoutPoint f g hf hg b) ↔
    GluedReach (labelReachSetoid R M) (labelReachSetoid S M) f g a b := by
  constructor
  · intro h
    exact pushoutReach_to_gluedReach R S M f g hf hg h a b rfl rfl
  · exact gluedReach_to_pushoutReach R S M f g hf hg

/-- Compose the actual quotient bridge with the checked
matching-of-component-classes theorem. The hypotheses are precisely the
matching and attachment facts; no global chain theorem is assumed. -/
theorem pushoutReach_iff_matchingClass_eq
    (R : E → X → X → Prop) (S : E → Y → Y → Prop)
    (M : Finset E) (f : Z → X) (g : Z → Y)
    (hf : Function.Injective f) (hg : Function.Injective g)
    (T : Matching
      (Sum (Quotient (labelReachSetoid R M))
        (Quotient (labelReachSetoid S M))))
    (hAttach : ∀ z : Z,
      T.Rel (.inl (Quotient.mk (labelReachSetoid R M) (f z)))
        (.inr (Quotient.mk (labelReachSetoid S M) (g z))))
    (hOld : ∀ x x' : Quotient (labelReachSetoid R M),
      ¬ T.Rel (.inl x) (.inl x'))
    (hNew : ∀ y y' : Quotient (labelReachSetoid S M),
      ¬ T.Rel (.inr y) (.inr y'))
    (hComplete : MatchesAttachment
      (labelReachSetoid R M) (labelReachSetoid S M) f g T)
    (a b : Sum X Y) :
    LabelReach (pushoutLabelRel R S f g hf hg) M
      (pushoutPoint f g hf hg a) (pushoutPoint f g hf hg b) ↔
    componentClass (labelReachSetoid R M) (labelReachSetoid S M) T a =
      componentClass (labelReachSetoid R M) (labelReachSetoid S M) T b := by
  rw [pushoutReach_iff_gluedReach R S M f g hf hg a b]
  exact gluedReach_iff_matching_class_eq
    (labelReachSetoid R M) (labelReachSetoid S M)
    f g T hAttach hOld hNew hComplete a b

end GluingEPPA.Steiner.ChainValuation
