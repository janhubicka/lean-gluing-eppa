import GluingEPPA.Steiner.ChainValuation.RestrictionLink

/-!
# Components of an attachment matching

A matching has no nontrivial paths of length two: two consecutive matching
edges reverse one another. Its connected components are therefore exactly
the equivalence classes of equality-or-one-matching-edge. For restricted
Cayley-chain attachments this gives the combinatorial part of the no-merging
step without choosing paths or quotient representatives.
-/

namespace GluingEPPA.Steiner.ChainValuation

universe u v w
variable {X : Type u} {Y : Type v}

/-- The connectivity equivalence relation generated by a matching already
equals equality or one matching edge. -/
def Matching.componentSetoid (M : Matching X) : Setoid X where
  r x y := x = y ∨ M.Rel x y
  iseqv := by
    refine ⟨?_, ?_, ?_⟩
    · intro x
      exact Or.inl rfl
    · intro x y h
      rcases h with rfl | hxy
      · exact Or.inl rfl
      · exact Or.inr (M.symm hxy)
    · intro x y z hxy hyz
      rcases hxy with rfl | hxy
      · exact hyz
      rcases hyz with rfl | hyz
      · exact Or.inr hxy
      have hyx : M.Rel y x := M.symm hxy
      exact Or.inl (M.unique hyx hyz).symm

/-- In the quotient, two vertices agree exactly when they are equal or
are joined by a single matching edge. -/
theorem Matching.quotient_eq_iff (M : Matching X) (x y : X) :
    (Quotient.mk (M.componentSetoid) x) =
        Quotient.mk (M.componentSetoid) y ↔
      x = y ∨ M.Rel x y := by
  constructor
  · intro h
    exact Quotient.exact h
  · intro h
    exact Quotient.sound h

/-- A matching between left and right pieces cannot identify distinct
pieces on the left. -/
theorem Matching.inl_component_injective
    (M : Matching (Sum X Y))
    (hside : ∀ x x' : X, ¬ M.Rel (.inl x) (.inl x')) :
    Function.Injective
      (fun x : X => Quotient.mk M.componentSetoid (Sum.inl x)) := by
  intro x x' h
  rcases (M.quotient_eq_iff (Sum.inl x) (Sum.inl x')).mp h with heq | hrel
  · cases heq
    rfl
  · exact False.elim (hside x x' hrel)

/-- Nor can it identify two distinct right-side pieces. -/
theorem Matching.inr_component_injective
    (M : Matching (Sum X Y))
    (hside : ∀ y y' : Y, ¬ M.Rel (.inr y) (.inr y')) :
    Function.Injective
      (fun y : Y => Quotient.mk M.componentSetoid (Sum.inr y)) := by
  intro y y' h
  rcases (M.quotient_eq_iff (Sum.inr y) (Sum.inr y')).mp h with heq | hrel
  · cases heq
    rfl
  · exact False.elim (hside y y' hrel)

/-- Restricted old coset pieces remain distinct in the component quotient of
a single attachment, even when their common subgroup is noncentral. -/
theorem restrictedPiece_old_injective
    {G : Type w} [Group G] {P Q I R : Subgroup G}
    (hPI : P ⊓ I = R) (hQI : Q ⊓ I = R) (h : G) :
    Function.Injective
      (fun oldPiece : Set G =>
        Quotient.mk
          (restrictedAttachmentMatching hPI hQI h).componentSetoid
          (Sum.inl oldPiece)) := by
  apply Matching.inl_component_injective
  intro x x' hx
  exact hx

/-- The same holds for new coset pieces. -/
theorem restrictedPiece_new_injective
    {G : Type w} [Group G] {P Q I R : Subgroup G}
    (hPI : P ⊓ I = R) (hQI : Q ⊓ I = R) (h : G) :
    Function.Injective
      (fun newPiece : Set G =>
        Quotient.mk
          (restrictedAttachmentMatching hPI hQI h).componentSetoid
          (Sum.inr newPiece)) := by
  apply Matching.inr_component_injective
  intro y y' hy
  exact hy

end GluingEPPA.Steiner.ChainValuation
