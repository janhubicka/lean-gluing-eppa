import GluingEPPA.Steiner.ChainValuation.MatchingComponentStep

/-!
# Connectivity of a new layer in a matching gluing

Fix equivalence relations describing the restricted components on the old
chain and the new Cayley block. Suppose the induced attachment relation on
these component classes is a bipartite matching, and its edges are exactly
the overlaps of the attaching maps. Then the equivalence relation generated
by old connectivity, new connectivity, and the attaching pairs is *exactly*
the quotient by that matching.

This is the abstract connectivity lemma required for the inductive
chain-restriction theorem. The remaining work instantiates it with actual
M-walk components of the injective Cayley-chain pushout.
-/

namespace GluingEPPA.Steiner.ChainValuation

universe u v w
variable {X : Type u} {Y : Type v} {Z : Type w}

/-- The equivalence generated by already-connected pieces and the new
attachment. It explicitly permits reversing and concatenating paths. -/
inductive GluedReach
    (RX : Setoid X) (RY : Setoid Y)
    (f : Z → X) (g : Z → Y) :
    Sum X Y → Sum X Y → Prop
  | refl (a) : GluedReach RX RY f g a a
  | old {x y} (h : RX.r x y) :
      GluedReach RX RY f g (.inl x) (.inl y)
  | new {x y} (h : RY.r x y) :
      GluedReach RX RY f g (.inr x) (.inr y)
  | attach (z : Z) :
      GluedReach RX RY f g (.inl (f z)) (.inr (g z))
  | symm {a b} (h : GluedReach RX RY f g a b) :
      GluedReach RX RY f g b a
  | trans {a b c}
      (h : GluedReach RX RY f g a b)
      (k : GluedReach RX RY f g b c) :
      GluedReach RX RY f g a c

def componentTag (RX : Setoid X) (RY : Setoid Y) :
    Sum X Y → Sum (Quotient RX) (Quotient RY)
  | .inl x => .inl (Quotient.mk RX x)
  | .inr y => .inr (Quotient.mk RY y)

/-- The matching class of each actual old/new occurrence. -/
def componentClass
    (RX : Setoid X) (RY : Setoid Y)
    (M : Matching (Sum (Quotient RX) (Quotient RY))) :
    Sum X Y → Quotient M.componentSetoid :=
  fun x => Quotient.mk M.componentSetoid (componentTag RX RY x)

/-- Any generated walk preserves the matching component. -/
theorem gluedReach_sound
    (RX : Setoid X) (RY : Setoid Y)
    (f : Z → X) (g : Z → Y)
    (M : Matching (Sum (Quotient RX) (Quotient RY)))
    (hAttach : ∀ z : Z,
      M.Rel (.inl (Quotient.mk RX (f z)))
        (.inr (Quotient.mk RY (g z))))
    {a b : Sum X Y}
    (h : GluedReach RX RY f g a b) :
    componentClass RX RY M a = componentClass RX RY M b := by
  induction h with
  | refl _ => rfl
  | old h =>
      exact Quotient.sound (Or.inl (congrArg Sum.inl (Quotient.sound h)))
  | new h =>
      exact Quotient.sound (Or.inl (congrArg Sum.inr (Quotient.sound h)))
  | attach z =>
      exact Quotient.sound (Or.inr (hAttach z))
  | symm _ ih =>
      exact ih.symm
  | trans _ _ ih1 ih2 =>
      exact ih1.trans ih2

/-- A matching edge between old and new component classes is witnessed by
an actual point of the attaching set. -/
def MatchesAttachment
    (RX : Setoid X) (RY : Setoid Y)
    (f : Z → X) (g : Z → Y)
    (M : Matching (Sum (Quotient RX) (Quotient RY))) : Prop :=
  ∀ x y,
    M.Rel (.inl x) (.inr y) →
      ∃ z : Z, Quotient.mk RX (f z) = x ∧
        Quotient.mk RY (g z) = y

/-- If the matching has no edges inside either layer, all identifications
in the matching quotient come from actual old/new paths and attachments. -/
theorem gluedReach_complete
    (RX : Setoid X) (RY : Setoid Y)
    (f : Z → X) (g : Z → Y)
    (M : Matching (Sum (Quotient RX) (Quotient RY)))
    (hOld : ∀ x x' : Quotient RX,
      ¬ M.Rel (.inl x) (.inl x'))
    (hNew : ∀ y y' : Quotient RY,
      ¬ M.Rel (.inr y) (.inr y'))
    (hComplete : MatchesAttachment RX RY f g M)
    {a b : Sum X Y}
    (h : componentClass RX RY M a = componentClass RX RY M b) :
    GluedReach RX RY f g a b := by
  have hrel := (M.quotient_eq_iff (componentTag RX RY a)
    (componentTag RX RY b)).mp h
  cases a with
  | inl x =>
    cases b with
    | inl x' =>
      rcases hrel with hEq | hEdge
      · apply GluedReach.old
        exact Quotient.exact (Sum.inl.inj hEq)
      · exact False.elim (hOld _ _ hEdge)
    | inr y =>
      rcases hrel with hEq | hEdge
      · cases hEq
      · obtain ⟨z, hx, hy⟩ := hComplete _ _ hEdge
        have hxl : RX.r x (f z) := Quotient.exact hx.symm
        have hyr : RY.r (g z) y := Quotient.exact hy
        exact GluedReach.trans (GluedReach.old hxl)
          (GluedReach.trans (GluedReach.attach z) (GluedReach.new hyr))
  | inr y =>
    cases b with
    | inl x =>
      rcases hrel with hEq | hEdge
      · cases hEq
      · have hReverse := M.symm hEdge
        obtain ⟨z, hx, hy⟩ := hComplete _ _ hReverse
        have hyl : RY.r y (g z) := Quotient.exact hy.symm
        have hxr : RX.r (f z) x := Quotient.exact hx
        exact GluedReach.trans (GluedReach.new hyl)
          (GluedReach.trans (GluedReach.symm (GluedReach.attach z))
            (GluedReach.old hxr))
    | inr y' =>
      rcases hrel with hEq | hEdge
      · exact GluedReach.new (Quotient.exact (Sum.inr.inj hEq))
      · exact False.elim (hNew _ _ hEdge)

/-- The explicit connectivity equivalence is exactly the matching quotient:
there are no hidden identifications after iterating an attachment. -/
theorem gluedReach_iff_matching_class_eq
    (RX : Setoid X) (RY : Setoid Y)
    (f : Z → X) (g : Z → Y)
    (M : Matching (Sum (Quotient RX) (Quotient RY)))
    (hAttach : ∀ z : Z,
      M.Rel (.inl (Quotient.mk RX (f z)))
        (.inr (Quotient.mk RY (g z))))
    (hOld : ∀ x x' : Quotient RX,
      ¬ M.Rel (.inl x) (.inl x'))
    (hNew : ∀ y y' : Quotient RY,
      ¬ M.Rel (.inr y) (.inr y'))
    (hComplete : MatchesAttachment RX RY f g M)
    (a b : Sum X Y) :
    GluedReach RX RY f g a b ↔
      componentClass RX RY M a = componentClass RX RY M b := by
  constructor
  · exact gluedReach_sound RX RY f g M hAttach
  · exact gluedReach_complete RX RY f g M hOld hNew hComplete

end GluingEPPA.Steiner.ChainValuation
