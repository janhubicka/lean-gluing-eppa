import GluingEPPA.Steiner.ChainValuation.ComponentReflection
import GluingEPPA.Steiner.ChainValuation.AugmentedLinks

/-!
# Component reflection for the literal augmented full stage

The component coordinate of the actual augmented record supplies the record
compatibility used by `chain_coset_component_reflection`. Word generation
and endpoint repair come from the same old Data and its actual Links. Thus
the reflection conclusion has no independent action-kernel or repair input.

The remaining family construction must supply these Links. The theorem here
already applies to the concrete augmented carrier, rather than an unrelated
group with a postulated faithful action.
-/

namespace GluingEPPA.Steiner
namespace EdgeGraph
namespace RecursiveRecord

universe u
variable {V E : Type u} (D : EdgeGraph V E)

namespace Link

/-- A canonical inclusion range is generated by the same allowed words. -/
theorem range_word_generation {M S : Finset E}
    (A : Data E M) (B : Data E S) (L : Link D A B)
    (g : B.Carrier) (hg : g ∈ L.incl.range) :
    ∃ w : List E, (∀ e ∈ w, e ∈ (M : Set E)) ∧
      (w.map B.edge).prod = g := by
  obtain ⟨x, rfl⟩ := hg
  obtain ⟨w, hw, hvalue⟩ := A.generated x
  refine ⟨w, hw, ?_⟩
  rw [← chain_word_map_value (B := (M : Set E)) (b := A.edge)
    B.edge L.incl L.incl_edge w hw, hvalue]

/-- The Link replacement property repairs every walk whose value is in its
inclusion range, with the value still expressed in the ambient group. -/
theorem repair_range {M S : Finset E}
    (A : Data E M) (B : Data E S) (L : Link D A B)
    {s t : V} {g : B.Carrier}
    (p : D.WalkValue (S : Set E) B.edge s t g)
    (hg : g ∈ L.incl.range) :
    D.WalkValue (M : Set E) B.edge s t g := by
  obtain ⟨x, hx⟩ := hg
  have p' : D.WalkValue (S : Set E) B.edge s t (L.incl x) := by
    simpa only [hx] using p
  have q := L.replace s t x p'
  have q' := (q.map L.incl).congr_edges L.incl_edge
  simpa only [hx] using q'

end Link

namespace AugmentedStep

variable [Finite V] [Fintype E] [DecidableEq E]
variable (old : ∀ i : Proper (Finset.univ : Finset E), Data E i.val)
variable {J : Type u} (X : J → Type u) [Finite J] [∀ j, Finite (X j)]
variable (τ : ∀ j, E → Equiv.Perm (X j))
variable (hτ : ∀ j e, τ j e * τ j e = 1)

/-- At the full alphabet every word is allowed, so equality in the literal
augmented group gives equality on every recorded old component coordinate. -/
theorem full_component_record (M : Proper (Finset.univ : Finset E))
    (p q : List E)
    (hvalue :
      (p.map (data D Finset.univ old X τ hτ).edge).prod =
      (q.map (data D Finset.univ old X τ hτ).edge).prod) :
    D.componentWordPerm (M.val : Set E) (old M).edge
        (fun e _ => (old M).square e) p =
      D.componentWordPerm (M.val : Set E) (old M).edge
        (fun e _ => (old M).square e) q := by
  exact AugmentedRecord.component_record_of_word_eq D
    (Step.sets Finset.univ) (Step.groups Finset.univ old)
    (Step.edges Finset.univ old) (Step.involutions Finset.univ old)
    X τ hτ ((Finset.univ : Finset E) : Set E) p q
    (by intro e he; simp) (by intro e he; simp) hvalue M

/-- Coset intersections are reflected by actual lifted component
intersections for the same full augmented record and its proper Links. -/
theorem linked_coset_component_reflection
    (A : Finset E) (DA : Data E A)
    (B : Proper (Finset.univ : Finset E))
    (LA : Link D DA (data D Finset.univ old X τ hτ))
    (LB : Link D (old B) (data D Finset.univ old X τ hτ))
    {s t : V} {g h : (data D Finset.univ old X τ hτ).Carrier}
    (hconnected : D.CayleyWalk Set.univ
      (data D Finset.univ old X τ hτ).edge s g t h) :
    (ChainValuation.leftCoset LA.incl.range g ∩
      ChainValuation.leftCoset LB.incl.range h).Nonempty ↔
      (D.componentSet (A : Set E)
          (data D Finset.univ old X τ hτ).edge (s, g) ∩
        D.componentSet (B.val : Set E)
          (data D Finset.univ old X τ hτ).edge (t, h)).Nonempty := by
  apply D.chain_coset_component_reflection
    (data D Finset.univ old X τ hτ).edge (B.val : Set E)
    (old B).edge (fun e _ => (old B).square e)
    LB.incl LB.incl_edge (data D Finset.univ old X τ hτ).square
    LA.incl.range
    (fun e he => ⟨DA.edge e, LA.incl_edge e he⟩)
    (Link.range_word_generation D DA _ LA)
    (old B).generated
    (full_component_record D old X τ hτ B)
    _ hconnected
  intro v w k p hk
  exact Link.repair_range D DA _ LA
    (by simpa only [Finset.coe_univ] using p) hk

/-- In particular, reflection holds for any two proper old-stage Links. -/
theorem proper_coset_component_reflection
    (A B : Proper (Finset.univ : Finset E))
    (LA : Link D (old A) (data D Finset.univ old X τ hτ))
    (LB : Link D (old B) (data D Finset.univ old X τ hτ))
    {s t : V} {g h : (data D Finset.univ old X τ hτ).Carrier}
    (hconnected : D.CayleyWalk Set.univ
      (data D Finset.univ old X τ hτ).edge s g t h) :
    (ChainValuation.leftCoset LA.incl.range g ∩
      ChainValuation.leftCoset LB.incl.range h).Nonempty ↔
      (D.componentSet (A.val : Set E)
          (data D Finset.univ old X τ hτ).edge (s, g) ∩
        D.componentSet (B.val : Set E)
          (data D Finset.univ old X τ hτ).edge (t, h)).Nonempty :=
  linked_coset_component_reflection D old X τ hτ A.val (old A) B LA LB hconnected

end AugmentedStep
end RecursiveRecord
end EdgeGraph
end GluingEPPA.Steiner
