import GluingEPPA.Steiner.WalkAction

/-!
# The generated subgroup in one step of the finite construction

The ambient group can be the product of the old group and permutation
coordinates. Its smaller-group homomorphisms are provided by the restriction
lemma. This file constructs the new embeddings, proves that the regular
coordinates are left inverses, and derives the new walk-replacement assertion.
It does not assume an embedding into the new generated subgroup.
-/

namespace GluingEPPA.Steiner

universe u v w z t

variable {E : Type u} {P : Type v} {H : Type w} {Q : Type z}
variable [Group P] [Group H] [Group Q]

@[simp] theorem map_wordValue (f : H →* P) (b : E → H) (w : List E) :
    f (wordValue b w) = wordValue (fun e => f (b e)) w := by
  induction w with
  | nil => simp
  | cons e w ih => simp only [wordValue_cons, map_mul, ih]

/-- Maps out of an involutively generated group are determined by its named
positive-word generators. -/
theorem hom_ext_of_words (b : E → H)
    (hgen : ∀ g, ∃ w, wordValue b w = g)
    (f g : H →* P) (hfg : ∀ e, f (b e) = g (b e)) : f = g := by
  ext x
  obtain ⟨w, rfl⟩ := hgen x
  induction w with
  | nil => simp
  | cons e w ih => simp only [wordValue_cons, map_mul, hfg, ih]

namespace GeneratedStep

variable (a : E → P) (ha : ∀ e, a e * a e = 1)

/-- Positive word values form the subgroup generated by the involutions. -/
abbrev Carrier := wordSubgroup a ha

def generator (e : E) : Carrier a ha :=
  ⟨a e, ⟨[e], wordValue_singleton a e⟩⟩

@[simp] theorem generator_val (e : E) : (generator a ha e).val = a e := rfl

theorem generator_involutive (e : E) :
    generator a ha e * generator a ha e = 1 := by
  apply Subtype.ext
  exact ha e

@[simp] theorem wordValue_val (w : List E) :
    (wordValue (generator a ha) w).val = wordValue a w := by
  induction w with
  | nil => rfl
  | cons e w ih =>
      change a e * (wordValue (generator a ha) w).val = a e * wordValue a w
      rw [ih]

theorem generated (g : Carrier a ha) :
    ∃ w, wordValue (generator a ha) w = g := by
  obtain ⟨w, hw⟩ := g.property
  refine ⟨w, ?_⟩
  apply Subtype.ext
  exact (wordValue_val a ha w).trans hw

instance [Finite P] : Finite (Carrier a ha) := inferInstance

/-- Restrict any ambient coordinate homomorphism to the generated subgroup. -/
def coordinate (f : P →* Q) : Carrier a ha →* Q where
  toFun g := f g.val
  map_one' := map_one f
  map_mul' g h := map_mul f g.val h.val

@[simp] theorem coordinate_generator (f : P →* Q) (e : E) :
    coordinate a ha f (generator a ha e) = f (a e) := rfl

variable {F : Type t} (b : F → H) (j : F → E)
variable (hgen : ∀ g, ∃ w, wordValue b w = g)
variable (φ : H →* P) (hφ : ∀ e, φ (b e) = a (j e))

theorem mapped_word (w : List F) :
    φ (wordValue b w) = wordValue a (w.map j) := by
  induction w with
  | nil => simp
  | cons e w ih => simp only [wordValue_cons, List.map_cons, map_mul, hφ, ih]

theorem image_mem (g : H) : φ g ∈ wordSubgroup a ha := by
  obtain ⟨w, hw⟩ := hgen g
  refine ⟨w.map j, ?_⟩
  rw [← mapped_word a b j φ hφ w, hw]

/-- Construct the smaller-group map into the actual new subgroup. -/
def inclusion : H →* Carrier a ha where
  toFun g := ⟨φ g, image_mem a ha b j hgen φ hφ g⟩
  map_one' := Subtype.ext (map_one φ)
  map_mul' g h := Subtype.ext (map_mul φ g h)

@[simp] theorem inclusion_val (g : H) :
    (inclusion a ha b j hgen φ hφ g).val = φ g := rfl

@[simp] theorem inclusion_generator (e : F) :
    inclusion a ha b j hgen φ hφ (b e) = generator a ha (j e) := by
  apply Subtype.ext
  exact hφ e

/-- The retained regular coordinate is a left inverse on the whole smaller
 group, not only on its generators. -/
theorem coordinate_leftInverse (r : P →* H) (hr : ∀ e, r (a (j e)) = b e) :
    Function.LeftInverse (coordinate a ha r) (inclusion a ha b j hgen φ hφ) := by
  have hid : r.comp φ = MonoidHom.id H := by
    apply hom_ext_of_words b hgen
    intro e
    change r (φ (b e)) = b e
    rw [hφ, hr]
  intro g
  exact DFunLike.congr_fun hid g

theorem inclusion_injective (r : P →* H) (hr : ∀ e, r (a (j e)) = b e) :
    Function.Injective (inclusion a ha b j hgen φ hφ) :=
  (coordinate_leftInverse a ha b j hgen φ hφ r hr).injective

/-- Agreement of the old and new action coordinates extends from generators
 to all elements of the smaller group. -/
theorem coordinate_inclusion (q : P →* Q) (θ : H →* Q)
    (hq : ∀ e, q (a (j e)) = θ (b e)) (g : H) :
    coordinate a ha q (inclusion a ha b j hgen φ hφ g) = θ g := by
  have heq : q.comp φ = θ := by
    apply hom_ext_of_words b hgen
    intro e
    change q (φ (b e)) = θ (b e)
    rw [hφ, hq]
  exact DFunLike.congr_fun heq g

/-- The actual path-replacement assertion for a constructed stage. The
 ambient coordinate and old-group map are given, but the new subgroup and
 its embedding are the concrete constructions above. -/
theorem replacement {V : Type z}
    (T : Transport V H) (D : EdgeGraph V E) (S : Set E)
    (q : P →* Equiv.Perm T.Space)
    (hq : ∀ e, q (a (j e)) = T.action (b e))
    (hedge : ∀ e ∈ S, ∀ u v, D.Joins e u v →
      q (a e) (T.marked u) = T.marked v)
    {u v : V} {k : Carrier a ha} {g : H}
    (p : D.WalkValue S (generator a ha) u v k)
    (hk : k = inclusion a ha b j hgen φ hφ g) : T.Rel u v g := by
  apply T.replacement_of_coordinate D S (generator a ha)
    (fun e _ => generator_involutive a ha e)
    (inclusion a ha b j hgen φ hφ) (coordinate a ha q) ?_ ?_ p hk
  · intro h
    exact coordinate_inclusion a ha b j hgen φ hφ q T.action hq h
  · intro e he u v hj
    exact hedge e he u v hj

end GeneratedStep
end GluingEPPA.Steiner
