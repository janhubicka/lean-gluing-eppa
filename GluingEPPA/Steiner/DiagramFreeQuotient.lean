import GluingEPPA.Steiner.DiagramSteinerTransport

/-!
# The points of the free realization of a labelled gluing diagram

After identifying every gluing map with the identity on a closed overlap,
an occurrence is (base vertex, valuation vertex, point label), where the
label belongs to the local Steiner system. Two occurrences are identified
exactly when they have the same point label and a walk between their
lifted vertices using only edges carrying that label.

This is equation (point-components) of the manuscript. The quotient is
defined from actual walks, not from equality in a coarser projection.
-/

namespace GluingEPPA.Steiner.EdgeGraph.RecursiveRecord

attribute [local instance] Classical.propDecidable

universe u w
variable {V E : Type u} {Ω : Type w}
variable (D : EdgeGraph V E)

/-- Labelled local Steiner systems whose gluing maps are the identity
    on prescribed closed overlaps. This retains the local incidence
    data even when two subsystems have the same underlying point set. -/
structure LabelledSteiner (Ω : Type w) where
  present : V → Ω → Prop
  triple : V → Ω → Ω → Ω → Prop
  triple_present : ∀ u x y z, triple u x y z →
    present u x ∧ present u y ∧ present u z
  triple_unique : ∀ u x y z z', triple u x y z →
    triple u x y z' → z = z'
  triple_swap : ∀ u x y z, triple u x y z → triple u y x z
  triple_rotate : ∀ u x y z, triple u x y z → triple u y z x
  triple_distinct : ∀ u x y z, triple u x y z →
    x ≠ y ∧ x ≠ z ∧ y ≠ z
  overlap : E → Set Ω
  overlap_present : ∀ e x, x ∈ overlap e →
    present (D.source e) x ∧ present (D.target e) x
  overlap_closed : ∀ e u v x y z, D.Joins e u v →
    triple u x y z → x ∈ overlap e → y ∈ overlap e →
    z ∈ overlap e ∧ triple v x y z

/-- An occurrence of a point in a local copy, before identifications. -/
structure PointOccurrence (L : D.LabelledSteiner Ω) (G : Type u) where
  site : V
  sheet : G
  label : Ω
  valid : L.present site label

/-- Equality of free-realization points is generated by gluing walks;
    the point label itself cannot change along a gluing identification. -/
def pointSetoid (L : D.LabelledSteiner Ω)
    {G : Type u} [Group G] (a : E → G)
    (ha : ∀ e, a e * a e = 1) :
    Setoid (D.PointOccurrence L G) where
  r p q := p.label = q.label ∧
    D.CayleyWalk (edgesCarrying L.overlap p.label)
      a p.site p.sheet q.site q.sheet
  iseqv := ⟨
    (fun p => ⟨rfl, D.CayleyWalk.nil p.site p.sheet⟩),
    (by
      intro p q h
      refine ⟨h.1.symm, ?_⟩
      rw [← h.1]
      exact D.CayleyWalk.symm (fun e _ => ha e) h.2),
    (by
      intro p q r hp hq
      refine ⟨hp.1.trans hq.1, ?_⟩
      have qr := hq.2
      rw [← hp.1] at qr
      exact D.CayleyWalk.trans hp.2 qr)⟩

/-- All the points of the finite free quotient. -/
def FreePoint (L : D.LabelledSteiner Ω)
    {G : Type u} [Group G] (a : E → G)
    (ha : ∀ e, a e * a e = 1) : Type _ :=
  Quotient (D.pointSetoid L a ha)

/-- Image of a local point in the free realization. -/
def pointAt (L : D.LabelledSteiner Ω)
    {G : Type u} [Group G] (a : E → G)
    (ha : ∀ e, a e * a e = 1)
    (u : V) (g : G) (x : Ω) (hx : L.present u x) :
    D.FreePoint L a ha :=
  Quotient.mk (D.pointSetoid L a ha)
    ⟨u, g, x, hx⟩

/-- The explicit criterion for equality in the free quotient. -/
theorem pointAt_eq_iff (L : D.LabelledSteiner Ω)
    {G : Type u} [Group G] (a : E → G)
    (ha : ∀ e, a e * a e = 1)
    (u v : V) (g h : G) (x y : Ω)
    (hx : L.present u x) (hy : L.present v y) :
    D.pointAt L a ha u g x hx = D.pointAt L a ha v h y hy ↔
      x = y ∧ D.CayleyWalk (edgesCarrying L.overlap x)
        a u g v h := by
  constructor
  · intro heq
    exact Quotient.exact heq
  · intro heq
    exact Quotient.sound heq

/-- Every individual local copy embeds injectively on its points. -/
theorem pointAt_injective (L : D.LabelledSteiner Ω)
    {G : Type u} [Group G] (a : E → G)
    (ha : ∀ e, a e * a e = 1)
    (u : V) (g : G) :
    Function.Injective
      (fun x : {x : Ω // L.present u x} =>
        D.pointAt L a ha u g x.val x.property) := by
  intro x y heq
  apply Subtype.ext
  exact (D.pointAt_eq_iff L a ha u u g g x.val y.val
    x.property y.property).mp heq |>.1

end GluingEPPA.Steiner.EdgeGraph.RecursiveRecord
