import GluingEPPA.Steiner.WalkAction

/-!
# Deletion maps and exact transport

The recursive group construction provides commuting deletion maps.
This file isolates their algebraic consequence and the final path-replacement
argument. The latter takes the replacement property as a hypothesis: the
unconditional construction is a separate theorem.
-/

namespace GluingEPPA.Steiner

universe u v w
variable {E : Type u} {G : Type v} [Group G]

/-- Commuting edge-deletion maps on a group generated by named edges. -/
structure DeletionSystem (E : Type u) (G : Type v) [Group G] where
  edge : E → G
  project : Set E → G →* G
  on_edge : ∀ S e, project S (edge e) = if e ∈ S then edge e else 1
  project_inter : ∀ S T, (project S).comp (project T) = project (S ∩ T)

namespace DeletionSystem

variable (D : DeletionSystem E G)

/-- An element lies in both fixed-point sets precisely when it is fixed
by deletion to the intersection. -/
theorem fixed_inter_iff (S T : Set E) (g : G) :
    D.project (S ∩ T) g = g ↔
      D.project S g = g ∧ D.project T g = g := by
  constructor
  · intro h
    have hs : D.project S (D.project (S ∩ T) g) =
        D.project (S ∩ T) g := by
      have hcomp := congrArg (fun f : G →* G => f g)
        (D.project_inter S (S ∩ T))
      change D.project S (D.project (S ∩ T) g) =
        D.project (S ∩ (S ∩ T)) g at hcomp
      simpa only [Set.inter_assoc, Set.inter_self] using hcomp
    have ht : D.project T (D.project (S ∩ T) g) =
        D.project (S ∩ T) g := by
      have hcomp := congrArg (fun f : G →* G => f g)
        (D.project_inter T (S ∩ T))
      change D.project T (D.project (S ∩ T) g) =
        D.project (T ∩ (S ∩ T)) g at hcomp
      have hsets : T ∩ (S ∩ T) = S ∩ T := by
        ext x
        simp [and_left_comm, and_assoc]
      simpa only [hsets] using hcomp
    constructor
    · calc
        D.project S g = D.project S (D.project (S ∩ T) g) :=
          congrArg (D.project S) h.symm
        _ = D.project (S ∩ T) g := hs
        _ = g := h
    · calc
        D.project T g = D.project T (D.project (S ∩ T) g) :=
          congrArg (D.project T) h.symm
        _ = D.project (S ∩ T) g := ht
        _ = g := h
  · rintro ⟨hs, ht⟩
    have hcomp := congrArg (fun f : G →* G => f g) (D.project_inter S T)
    change D.project S (D.project T g) = D.project (S ∩ T) g at hcomp
    calc
      D.project (S ∩ T) g = D.project S (D.project T g) := hcomp.symm
      _ = g := by rw [ht, hs]

/-- Elements fixed by one deletion form a subgroup. -/
def fixedSubgroup (S : Set E) : Subgroup G where
  carrier := {g | D.project S g = g}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb
    simpa only [Set.mem_setOf_eq, map_mul, ha, hb]
  inv_mem' := by
    intro a ha
    simpa only [Set.mem_setOf_eq, map_inv, ha]

theorem fixedSubgroup_inf (S T : Set E) :
    D.fixedSubgroup S ⊓ D.fixedSubgroup T =
      D.fixedSubgroup (S ∩ T) := by
  apply Subgroup.ext
  intro g
  change (D.project S g = g ∧ D.project T g = g) ↔
    D.project (S ∩ T) g = g
  exact (D.fixed_inter_iff S T g).symm

variable {V : Type w}

/-- The value of an actual walk over S is fixed by deletion to S. -/
theorem walk_fixed (graph : EdgeGraph V E) {S : Set E}
    {u v : V} {g : G} (p : graph.WalkValue S D.edge u v g) :
    D.project S g = g := by
  induction p with
  | nil => simp
  | @cons u v w e g he hj p ih =>
      change D.project S (D.edge e * g) = D.edge e * g
      rw [map_mul, D.on_edge, if_pos he, ih]

/-- Equal-valued carrying walks admit a joint walk, provided the finite
group has the walk-replacement property. -/
theorem exact_transport (graph : EdgeGraph V E)
    (replace : ∀ (S : Set E) (u v : V) (g : G),
      graph.WalkValue Set.univ D.edge u v g →
      D.project S g = g →
      graph.WalkValue S D.edge u v g)
    {S T : Set E} {u v : V} {g : G}
    (p : graph.WalkValue S D.edge u v g)
    (q : graph.WalkValue T D.edge u v g) :
    graph.WalkValue (S ∩ T) D.edge u v g := by
  have hs := D.walk_fixed graph p
  have ht := D.walk_fixed graph q
  have hint := (D.fixed_inter_iff S T g).mpr ⟨hs, ht⟩
  have hall : graph.WalkValue Set.univ D.edge u v g :=
    p.mono (by intro e he; trivial)
  exact replace (S ∩ T) u v g hall hint

theorem exact_transport_iff (graph : EdgeGraph V E)
    (replace : ∀ (S : Set E) (u v : V) (g : G),
      graph.WalkValue Set.univ D.edge u v g →
      D.project S g = g →
      graph.WalkValue S D.edge u v g)
    (S T : Set E) (u v : V) (g : G) :
    graph.WalkValue (S ∩ T) D.edge u v g ↔
      graph.WalkValue S D.edge u v g ∧
      graph.WalkValue T D.edge u v g := by
  constructor
  · intro p
    exact ⟨p.mono (by intro e he; exact he.1),
      p.mono (by intro e he; exact he.2)⟩
  · rintro ⟨p, q⟩
    exact D.exact_transport graph replace p q

end DeletionSystem
end GluingEPPA.Steiner
