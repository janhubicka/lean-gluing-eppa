import GluingEPPA.Steiner.MaskIntersection
import GluingEPPA.Steiner.GeneratedStep

/-!
# Generation by retained edge names

This identifies the fixed points of deletion with the subgroup generated by
retained edges, assuming the whole group is generated by named involutions.
-/

namespace GluingEPPA.Steiner
universe u v
variable {E : Type u} {G : Type v} [Group G]
attribute [local instance] Classical.propDecidable

/-- Maps deleting named generators commute when the full group is generated
by those generators. -/
theorem project_inter_of_generation (a : E → G)
    (hgen : ∀ g, ∃ w : List E, wordValue a w = g)
    (project : Set E → G →* G)
    (hon : ∀ S e, project S (a e) = if e ∈ S then a e else 1)
    (S T : Set E) :
    (project S).comp (project T) = project (S ∩ T) := by
  apply hom_ext_of_words a hgen
  intro e
  change project S (project T (a e)) = project (S ∩ T) (a e)
  by_cases hs : e ∈ S <;> by_cases ht : e ∈ T <;>
    simp [hon, hs, ht]

namespace DeletionSystem
variable (D : DeletionSystem E G)

def generated (S : Set E) : Subgroup G := Subgroup.closure (D.edge '' S)

theorem generated_le_fixed (S : Set E) :
    D.generated S ≤ D.fixedSubgroup S := by
  apply (Subgroup.closure_le (D.fixedSubgroup S)).mpr
  rintro x ⟨e, he, rfl⟩
  change D.project S (D.edge e) = D.edge e
  rw [D.on_edge, ite_eq_left he]

theorem project_mem_generated
    (hgen : ∀ g, ∃ w : List E, wordValue D.edge w = g)
    (S : Set E) (g : G) : D.project S g ∈ D.generated S := by
  obtain ⟨w, hw⟩ := hgen g
  subst g
  induction w with
  | nil =>
      simpa only [wordValue_nil, map_one] using (D.generated S).one_mem
  | cons e w ih =>
      change D.project S (D.edge e * wordValue D.edge w) ∈ D.generated S
      rw [map_mul, D.on_edge]
      by_cases he : e ∈ S
      · rw [ite_eq_left he]
        exact (D.generated S).mul_mem
          (Subgroup.subset_closure ⟨e, he, rfl⟩) ih
      · simpa [he] using ih

theorem generated_eq_fixed
    (hgen : ∀ g, ∃ w : List E, wordValue D.edge w = g)
    (S : Set E) : D.generated S = D.fixedSubgroup S := by
  apply le_antisymm
  · exact D.generated_le_fixed S
  · intro g hg
    have hp := D.project_mem_generated hgen S g
    change D.project S g = g at hg
    simpa only [hg] using hp

theorem generated_inf
    (hgen : ∀ g, ∃ w : List E, wordValue D.edge w = g)
    (S T : Set E) :
    D.generated S ⊓ D.generated T = D.generated (S ∩ T) := by
  calc
    D.generated S ⊓ D.generated T =
        D.fixedSubgroup S ⊓ D.fixedSubgroup T := by
          rw [D.generated_eq_fixed hgen S, D.generated_eq_fixed hgen T]
    _ = D.fixedSubgroup (S ∩ T) := D.fixedSubgroup_inf S T
    _ = D.generated (S ∩ T) := (D.generated_eq_fixed hgen (S ∩ T)).symm

end DeletionSystem
end GluingEPPA.Steiner
